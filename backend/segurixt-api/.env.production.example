# Plantilla de nombres; completar fuera de Git. No se copia al contenedor.
SPRING_PROFILES_ACTIVE=prod
PORT=10000
DB_JDBC_URL=jdbc:mysql://mysql.example.com:3306/segurixt_db?sslMode=VERIFY_IDENTITY
DB_USERNAME=
DB_PASSWORD=
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=segurixt-api
AUTH_CORS_ORIGINS=https://segurixt.example.com
PRODUCTS_IMAGES_DIRECTORY=/var/data/productos
DB_POOL_SIZE=5
